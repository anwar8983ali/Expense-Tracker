# MongoDB Atlas connection string
MONGO_URI=

# Any long random string, e.g. generate one with: openssl rand -hex 32
SESSION_SECRET=

PORT=8080

# Gmail (or other SMTP) credentials used to send password-reset OTP emails.
# If using Gmail, EMAIL_PASS must be an App Password, not your real password.
EMAIL_USER=
EMAIL_PASS=

# Your deployed frontend URL, e.g. https://your-app.vercel.app
# Used for CORS in production. Leave unset for local dev (defaults to
# http://localhost:5173).
CLIENT_URL=

# Set to "production" when deployed (Render sets this automatically on
# most plans, but confirm it's set to be safe — it controls cookie
# security settings).
NODE_ENV=
